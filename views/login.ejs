<section class="auth-wrapper">
  <div class="card auth-card">
    <h1>Login</h1>
    <p class="muted">Use your account or try the demo login below.</p>
    <div class="demo-box">
      <strong>Demo account:</strong><br>
      praveen@example.com / Password123
    </div>
    <form method="POST" action="/login" class="form">
      <label>Email
        <input type="email" name="email" value="<%= form.email || '' %>" required>
      </label>
      <label>Password
        <input type="password" name="password" required>
      </label>
      <button class="btn btn-primary full-width" type="submit">Login</button>
    </form>
    <p class="auth-note">New to SkillSwap? <a href="/register">Create an account</a></p>
  </div>
</section>
